#!/bin/bash

# zen0x:summary=Launch an app or focus an existing window matching a pattern
# zen0x:args=<window-pattern> <launch-command>

if (($# == 0)); then
  echo "Usage: zen0x-launch-or-focus [window-pattern] [launch-command]"
  exit 1
fi

WINDOW_PATTERN="$1"
LAUNCH_COMMAND="${2:-"$WINDOW_PATTERN"}"

if command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  WINDOW_ADDRESS=$(
    hyprctl clients -j | jq -r --arg p "$WINDOW_PATTERN" \
      '.[]|select((.class|test("\\b" + $p + "\\b";"i")) or (.title|test("\\b" + $p + "\\b";"i")))|.address' \
      | head -n1
  )

  if [[ -n $WINDOW_ADDRESS ]]; then
    hyprctl dispatch "hl.dsp.focus({ window = \"address:$WINDOW_ADDRESS\" })" >/dev/null 2>&1 \
      || hyprctl dispatch focuswindow "address:$WINDOW_ADDRESS"
    exit $?
  fi
fi

exec setsid /bin/sh -lc "$LAUNCH_COMMAND"
